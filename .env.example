# ============================================
# Vue-FastAPI-Admin Docker Environment Variables
# ============================================
# Copy this file to .env and modify as needed
# cp .env.example .env

# ============================================
# OAuth2 Configuration (optional)
# ============================================
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_SERVER_BASE_URL=http://your-oauth-server:99/oauth2Server
OAUTH_REDIRECT_URI=http://localhost:9090/api/v1/auth/oauth2/callback
FRONTEND_URL=http://localhost:80

# ============================================
# JumpServer Configuration (for switch management)
# ============================================
JUMPSERVER_URL=https://your-jumpserver-url
ACCESS_KEY_ID=your_access_key_id
ACCESS_KEY_SECRET=your_access_key_secret
ORG_ID=your_org_id

# ============================================
# Database Configuration
# ============================================
# SQLite (default)
DATABASE_URL=sqlite:///opt/vue-fastapi-admin/backend/db.sqlite3

# PostgreSQL (uncomment in docker-compose.yml to use)
# DATABASE_URL=postgresql://admin:changeme@postgres:5432/vue_fastapi_admin
DB_PASSWORD=changeme

# ============================================
# Application Settings
# ============================================
BACKEND_PORT=9090
WORKERS=4

# ============================================
# SSL/TLS (if using reverse proxy)
# ============================================
VERIFY_SSL=false
