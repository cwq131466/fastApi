# OAuth2 统一认证配置
OAUTH_ENABLED=true
OAUTH_CLIENT_ID=bTi5156I
OAUTH_CLIENT_SECRET=8f0a8098e60afbe33daa2202f2c813d5807f898f
OAUTH_SERVER_BASE_URL=http://32.15.80.150:99/oauth2Server
# 后端回调地址（统一认证服务回调到这里）
OAUTH_REDIRECT_URI=http://localhost:9099/api/v1/auth/oauth2/callback
# 前端地址（后端处理后重定向到这里，多个地址用逗号分隔）
# 第一个是 web_frontend (用户门户), 第二个是 web_backend (管理后台)
# 注意：统一认证服务器只在生产环境中存在，开发环境 OAUTH_ENABLED=false 时 OAuth2 按钮会显示错误提示
FRONTEND_URLS=http://32.15.80.145,http://32.15.80.145:82
VERIFY_SSL=false

# JWT 配置（如需要可修改）
# SECRET_KEY=your_secret_key_here
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (生产环境使用 MySQL)
# 数据库类型: sqlite 或 mysql
# 开发环境建议使用 sqlite，生产环境可改为 mysql
DB_TYPE=sqlite
# MySQL 连接配置（仅在 DB_TYPE=mysql 时生效）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vue_fastapi_admin

# JumpServer 配置（内网真实 JumpServer 服务器）
